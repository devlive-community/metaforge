<?xml version="1.0" encoding="UTF-8"?>
<!-- Fresh-install schema. Skipped when an installation already holds the metadata tables. -->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="core-0001-baseline" author="metaforge">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="metaforge_user"/>
            </not>
        </preConditions>
        <createTable tableName="metaforge_user">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_user" nullable="false"/>
            </column>
            <column name="name" type="${string}(100)"/>
            <column name="code" type="${string}(200)"/>
            <column name="active" type="${flag}" defaultValueBoolean="true"/>
            <column name="create_time" type="${instant}"/>
            <column name="update_time" type="${instant}"/>
            <column name="username" type="${string}(255)"/>
            <column name="password_hash" type="${string}(255)"/>
            <column name="chat_configure" type="${text}"/>
            <column name="is_system" type="${flag}" defaultValueBoolean="false"/>
            <column name="editor_configure" type="${text}"/>
            <column name="avatar_configure" type="${text}"/>
            <column name="notify_configure" type="${text}"/>
        </createTable>
        <createTable tableName="metaforge_role">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_role" nullable="false"/>
            </column>
            <column name="name" type="${string}(255)"/>
            <column name="code" type="${string}(100)"/>
            <column name="active" type="${flag}" defaultValueBoolean="true"/>
            <column name="create_time" type="${instant}"/>
            <column name="update_time" type="${instant}"/>
            <column name="description" type="${string}(1000)"/>
        </createTable>
        <addUniqueConstraint tableName="metaforge_role" columnNames="code" constraintName="uk_metaforge_role_code"/>
        <createTable tableName="metaforge_menu">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_menu" nullable="false"/>
            </column>
            <column name="name" type="${string}(255)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="${string}(255)"/>
            <column name="active" type="${flag}" defaultValueBoolean="true"/>
            <column name="create_time" type="${instant}"/>
            <column name="update_time" type="${instant}"/>
            <column name="description" type="${string}(255)"/>
            <column name="url" type="${string}(255)">
                <constraints nullable="false"/>
            </column>
            <column name="group_name" type="${string}(255)"/>
            <column name="sorted" type="INT" defaultValueNumeric="0"/>
            <column name="type" type="${string}(10)" defaultValue="VIEW"/>
            <column name="parent" type="BIGINT" defaultValueNumeric="0"/>
            <column name="i18n_key" type="${string}(255)"/>
            <column name="icon" type="${string}(255)"/>
            <column name="redirect" type="BIGINT" defaultValueNumeric="0"/>
            <column name="is_new" type="${flag}" defaultValueBoolean="false"/>
        </createTable>
        <createTable tableName="metaforge_configure">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_configure" nullable="false"/>
            </column>
            <column name="name" type="${string}(128)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="${string}(64)"/>
            <column name="active" type="${flag}" defaultValueBoolean="true"/>
            <column name="create_time" type="${instant}"/>
            <column name="update_time" type="${instant}"/>
            <column name="category" type="${string}(32)">
                <constraints nullable="false"/>
            </column>
            <column name="configure" type="${text}"/>
            <column name="description" type="${string}(512)"/>
        </createTable>
        <addUniqueConstraint tableName="metaforge_configure" columnNames="category, name" constraintName="uk_configure_category_name"/>
        <createTable tableName="metaforge_chat">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_chat" nullable="false"/>
            </column>
            <column name="name" type="${string}(255)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="${string}(100)"/>
            <column name="active" type="${flag}" defaultValueBoolean="true"/>
            <column name="create_time" type="${instant}"/>
            <column name="update_time" type="${instant}"/>
            <column name="avatar" type="${string}(255)"/>
            <column name="description" type="${string}(255)"/>
            <column name="user_id" type="BIGINT"/>
        </createTable>
        <createIndex tableName="metaforge_chat" indexName="idx_chat_user_id">
            <column name="user_id"/>
        </createIndex>
        <createTable tableName="metaforge_message">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_message" nullable="false"/>
            </column>
            <column name="name" type="${string}(255)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="${string}(100)"/>
            <column name="active" type="${flag}" defaultValueBoolean="true"/>
            <column name="create_time" type="${instant}"/>
            <column name="update_time" type="${instant}"/>
            <column name="content" type="${text}"/>
            <column name="model" type="${string}(255)"/>
            <column name="type" type="${string}(100)"/>
            <column name="prompt_tokens" type="BIGINT" defaultValueNumeric="0"/>
            <column name="completion_tokens" type="BIGINT" defaultValueNumeric="0"/>
            <column name="total_tokens" type="BIGINT" defaultValueNumeric="0"/>
            <column name="user_id" type="BIGINT"/>
            <column name="chat_id" type="BIGINT"/>
        </createTable>
        <createIndex tableName="metaforge_message" indexName="idx_message_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="metaforge_message" indexName="idx_message_chat_id">
            <column name="chat_id"/>
        </createIndex>
        <createTable tableName="metaforge_dashboard">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_dashboard" nullable="false"/>
            </column>
            <column name="name" type="${string}(255)"/>
            <column name="code" type="${string}(100)"/>
            <column name="active" type="${flag}" defaultValueBoolean="true"/>
            <column name="create_time" type="${instant}"/>
            <column name="update_time" type="${instant}"/>
            <column name="configure" type="${text}"/>
            <column name="description" type="${string}(1000)"/>
            <column name="avatar" type="${text}"/>
            <column name="version" type="${string}(100)" defaultValue="2.0"/>
            <column name="user_id" type="BIGINT"/>
        </createTable>
        <createIndex tableName="metaforge_dashboard" indexName="idx_dashboard_user_id">
            <column name="user_id"/>
        </createIndex>
        <createTable tableName="metaforge_report">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_report" nullable="false"/>
            </column>
            <column name="name" type="${string}(255)"/>
            <column name="code" type="${string}(100)"/>
            <column name="active" type="${flag}" defaultValueBoolean="true"/>
            <column name="create_time" type="${instant}"/>
            <column name="update_time" type="${instant}"/>
            <column name="configure" type="${text}"/>
            <column name="type" type="${string}(255)"/>
            <column name="realtime" type="${flag}" defaultValueBoolean="false"/>
            <column name="query" type="${text}"/>
