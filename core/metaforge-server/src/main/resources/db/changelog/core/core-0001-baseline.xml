            <column name="is_custom_column" type="${flag}" defaultValueBoolean="false"/>
            <column name="is_virtual_column" type="${flag}" defaultValueBoolean="false"/>
        </createTable>
        <createIndex tableName="metaforge_dataset_column" indexName="idx_dscol_dataset_id">
            <column name="dataset_id"/>
        </createIndex>
        <createTable tableName="metaforge_dataset_history">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_dataset_history" nullable="false"/>
            </column>
            <column name="name" type="${string}(255)"/>
            <column name="code" type="${string}(100)"/>
            <column name="active" type="${flag}" defaultValueBoolean="true"/>
            <column name="create_time" type="${instant}"/>
            <column name="update_time" type="${instant}"/>
            <column name="query" type="${text}"/>
            <column name="message" type="${text}"/>
            <column name="elapsed" type="BIGINT"/>
            <column name="count" type="INT"/>
            <column name="total_count" type="BIGINT"/>
            <column name="processed_count" type="BIGINT"/>
            <column name="progress" type="DECIMAL(5,2)"/>
            <column name="task_name" type="${string}(64)"/>
            <column name="work_home" type="${string}(512)"/>
            <column name="executor_configure" type="${text}"/>
            <column name="query_mode" type="${string}(255)"/>
