            <column name="dataset_id" type="BIGINT"/>
        </createTable>
        <createIndex tableName="metaforge_report" indexName="idx_report_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="metaforge_report" indexName="idx_report_source_id">
            <column name="source_id"/>
        </createIndex>
        <createIndex tableName="metaforge_report" indexName="idx_report_dataset_id">
            <column name="dataset_id"/>
        </createIndex>
        <createTable tableName="metaforge_dataset">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_dataset" nullable="false"/>
            </column>
            <column name="name" type="${string}(255)"/>
            <column name="code" type="${string}(100)"/>
            <column name="active" type="${flag}" defaultValueBoolean="true"/>
            <column name="create_time" type="${instant}"/>
            <column name="update_time" type="${instant}"/>
            <column name="description" type="${text}"/>
            <column name="query" type="${text}"/>
            <column name="sync_mode" type="${string}(100)"/>
            <column name="expression" type="${string}(100)"/>
            <column name="state" type="${string}(100)"/>
            <column name="message" type="${text}"/>
            <column name="table_name" type="${string}(255)"/>
            <column name="scheduler" type="${string}(100)" defaultValue="LocalScheduler"/>
            <column name="executor" type="${string}(100)" defaultValue="Local"/>
            <column name="total_rows" type="BIGINT" defaultValueNumeric="0"/>
            <column name="total_size" type="${string}(100)"/>
            <column name="life_cycle" type="BIGINT" defaultValueNumeric="0"/>
            <column name="life_cycle_column" type="${string}(100)"/>
            <column name="life_cycle_type" type="${string}(100)"/>
            <column name="user_id" type="BIGINT"/>
            <column name="source_id" type="BIGINT"/>
        </createTable>
        <createIndex tableName="metaforge_dataset" indexName="idx_dataset_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="metaforge_dataset" indexName="idx_dataset_source_id">
            <column name="source_id"/>
        </createIndex>
        <createTable tableName="metaforge_dataset_column">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_dataset_column" nullable="false"/>
            </column>
            <column name="name" type="${string}(255)"/>
            <column name="code" type="${string}(100)"/>
            <column name="active" type="${flag}" defaultValueBoolean="true"/>
            <column name="create_time" type="${instant}"/>
            <column name="update_time" type="${instant}"/>
            <column name="description" type="${text}"/>
            <column name="type" type="${string}(100)"/>
