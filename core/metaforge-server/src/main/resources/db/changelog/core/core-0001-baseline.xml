        <createIndex tableName="metaforge_dataset_history" indexName="idx_dshist_dataset_id">
            <column name="dataset_id"/>
        </createIndex>
        <createTable tableName="metaforge_function">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_function" nullable="false"/>
            </column>
            <column name="name" type="${string}(255)"/>
            <column name="code" type="${string}(100)"/>
            <column name="active" type="${flag}" defaultValueBoolean="true"/>
            <column name="create_time" type="${instant}"/>
            <column name="update_time" type="${instant}"/>
            <column name="content" type="${string}(255)"/>
            <column name="description" type="${text}"/>
            <column name="plugin" type="${string}(255)"/>
            <column name="example" type="${text}"/>
            <column name="type" type="${string}(20)" defaultValue="KEYWORD"/>
        </createTable>
        <createTable tableName="metaforge_notification">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_notification" nullable="false"/>
            </column>
            <column name="name" type="${string}(255)"/>
            <column name="code" type="${string}(100)"/>
            <column name="active" type="${flag}" defaultValueBoolean="true"/>
            <column name="create_time" type="${instant}"/>
            <column name="update_time" type="${instant}"/>
            <column name="content" type="${string}(255)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="${string}(255)"/>
            <column name="is_read" type="${flag}" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT"/>
            <column name="entity_type" type="${string}(255)"/>
            <column name="entity_code" type="${string}(255)"/>
            <column name="entity_name" type="${string}(255)"/>
            <column name="entity_exists" type="${flag}" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
